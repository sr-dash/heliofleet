{
  "name": "HelioFleet: Spacecraft Positions Around the Sun",
  "short_name": "HelioFleet",
  "description": "Where SDO, SOHO, Aditya-L1, Solar Orbiter, Parker Solar Probe, STEREO, BepiColombo and more are relative to the Sun and Earth on any date since 2010.",
  "id": "/heliofleet/",
  "start_url": "/heliofleet/",
  "scope": "/heliofleet/",
  "display": "standalone",
  "background_color": "#0B1026",
  "theme_color": "#0B1026",
  "lang": "en",
  "categories": [
    "education",
    "science"
  ],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "Map: the fleet now",
      "short_name": "Map",
      "url": "./",
      "description": "Where the spacecraft are around the Sun and Earth right now",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Sky view",
      "short_name": "Sky view",
      "url": "sky.html",
      "description": "Instrument fields of view and observation footprints on the plane of the sky",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Alignment search",
      "short_name": "Alignments",
      "url": "./?tab=align#tools",
      "description": "Radial alignments, quadratures and magnetic connections between spacecraft",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "How to use",
      "short_name": "Help",
      "url": "help.html",
      "description": "What every tool does, link parameters and examples",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
